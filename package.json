{
  "name": "mktbd-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"tests/unit/*.test.mjs\"",
