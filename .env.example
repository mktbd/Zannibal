# Supabase project URL and public anon key.
# Safe to expose to the browser (NEXT_PUBLIC_*) — access is governed by
# Postgres Row Level Security, not by keeping these secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key.
# NEVER prefix this with NEXT_PUBLIC_. Server-only — used exclusively by
# lib/supabase/admin.ts for privileged operations that must bypass RLS
# under explicit server-side authorization checks.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, local dev only. Used by `npm run gen:types` (see
# docs/SUPABASE_SETUP.md "Regenerating database types"). Not read by the
# application at runtime.
SUPABASE_PROJECT_ID=

# mktbd's receiving bKash number for the manual Case Study purchase flow
# (Stage 4E), e.g. 01XXXXXXXXX. Shown to customers on the purchase page, so
# it is not a secret, but it is read on the server only (no NEXT_PUBLIC_
# prefix) and can be changed without a rebuild. When unset or invalid,
# purchasing is paused: the purchase page says so and POST /api/orders
# refuses new orders. Never commit the real number.
BKASH_PAYMENT_NUMBER=
