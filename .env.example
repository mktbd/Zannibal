# Supabase project URL and public anon key.
# Safe to expose to the browser (NEXT_PUBLIC_*) — access is governed by
# Postgres Row Level Security, not by keeping these secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key.
# NEVER prefix this with NEXT_PUBLIC_. Server-only — used by
# lib/supabase/admin.ts for the two privileged operations behind
# POST /api/orders (recording Pending orders, and the shared rate limit in
# lib/order-rate-limit.ts, which also derives its IP-hashing key from it).
# Required to take orders: without it the endpoint fails closed (503).
SUPABASE_SERVICE_ROLE_KEY=

# Optional, local dev only. Used by `npm run gen:types` (see
# docs/SUPABASE_SETUP.md "Regenerating database types"). Not read by the
# application at runtime. Caution: the Supabase CLI also reads this from the
# environment -- with it set to the production project, `supabase start`
# reuses that name for local containers and linked commands can reach
# production. Unset it (and SUPABASE_ACCESS_TOKEN / SUPABASE_DB_PASSWORD)
# for local Supabase work; see docs/SUPABASE_SETUP.md section 8.
SUPABASE_PROJECT_ID=

# mktbd's receiving bKash number for the manual Case Study purchase flow
# (Stage 4E), e.g. 01XXXXXXXXX. Shown to customers on the purchase page, so
# it is not a secret, but it is read on the server only (no NEXT_PUBLIC_
# prefix) and can be changed without a rebuild. When unset or invalid,
# purchasing is paused: the purchase page says so and POST /api/orders
# refuses new orders. Never commit the real number.
# Non-production deployments (SITE_ENV other than "production") must use the
# non-payable placeholder STAGING-NOT-PAYABLE instead; a real number there
# pauses purchasing (Stage 5E-B2A).
BKASH_PAYMENT_NUMBER=

# Deployment environment outside Vercel (Stage 5E-B2A): "production" or any
# other value (treated as preview: noindex, staging banner, placeholder bKash
# recipient only). Falls back to VERCEL_ENV when unset. Server-only.
SITE_ENV=

# Hosting platform outside Vercel (Stage 5E-B2A). "cloudflare": the order
# rate limit keys on CF-Connecting-IP (set by Cloudflare, not the client).
DEPLOY_PLATFORM=

# Canonical site origin for canonical tags, Open Graph URLs, JSON-LD and
# the sitemap (Stage 5C). Optional: defaults to https://mktbd.co. Must be an
# absolute https origin with no path, e.g. https://staging.mktbd.co;
# invalid values fall back to the default with a warning. Server-only.
SITE_URL=

# Optional limits for POST /api/orders (Stage 5E-A), enforced in the
# database across all server instances, per one-hour sliding window.
# Defaults: 5 submissions per client IP, 100 across all clients. Invalid
# values fall back to the defaults. Server-only.
ORDER_RATE_LIMIT_PER_IP=
ORDER_RATE_LIMIT_GLOBAL=

# Optional, NOT for Vercel. On Vercel the client IP comes from headers the
# platform overwrites. Elsewhere, set to "true" only behind a proxy that
# overwrites X-Forwarded-For / X-Real-IP; otherwise those headers are
# client-controlled and all clients share one rate-limit bucket.
ORDER_RATE_LIMIT_TRUST_PROXY=
